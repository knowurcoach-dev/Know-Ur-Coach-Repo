# Database Connection (Supabase PostgreSQL)
# 1. DATABASE_URL: Transaction Connection Pooler (Port 6543) for Serverless Runtime (Netlify)
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct Session / DB Connection (Port 5432) for Prisma Migrations & Seeding
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth Configuration
# For Netlify production: set NEXTAUTH_URL to your Netlify custom domain (e.g., https://knowurcoach.netlify.app)
NEXTAUTH_URL="https://your-site-name.netlify.app"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Gmail SMTP Configuration for Email OTPs, Booking Passes & KYC Updates
GMAIL_USER="knowurcoach@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
SMTP_USER="knowurcoach@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_FROM="KnowUrCoach <knowurcoach@gmail.com>"

# Razorpay Payment & Escrow Webhooks
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_agra_2026"

# Meta WhatsApp Cloud API Webhook
WHATSAPP_VERIFY_TOKEN="knowurcoach_meta_verify_2026"
WHATSAPP_ACCESS_TOKEN="meta_graph_api_access_token_placeholder"

# Geocoding, Reverse Geocoding, Autocomplete, Maps & Routing (LocationIQ)
